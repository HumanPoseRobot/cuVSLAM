+    for (int j = row_offsets[row]; j < row_offsets[row + 1]; ++j) {
+      const int column = columns[j];
+      const double value = values[j];
+      gradient[column] -= value * residual_values[row];
+      for (int k = row_offsets[row]; k < row_offsets[row + 1]; ++k) {
+        normal[column][columns[k]] += value * values[k];
+      }
+    }
+  }
+  std::vector<float> hessian_values(hessian_columns.size());
+  float rhs_values[max_dimension];
+  for (size_t row = 0; row < dimension; ++row) {
+    rhs_values[row] = static_cast<float>(gradient[row]);
+    for (int j = hessian_rows[row]; j < hessian_rows[row + 1]; ++j) {
+      hessian_values[j] = static_cast<float>(normal[row][hessian_columns[j]]);
+    }
+  }
+  rhs.resize(dimension);
+  THROW_ON_CUDA_ERROR(cudaMemcpyAsync(hessian.values.data(), hessian_values.data(),
+                                    hessian_values.size() * sizeof(float), cudaMemcpyHostToDevice, stream));
+  THROW_ON_CUDA_ERROR(cudaMemcpyAsync(rhs.data(), rhs_values, dimension * sizeof(float),
