+  std::vector<int> hessian_rows(hessian.row_offsets.size()), hessian_columns(hessian.col_ids.size());
+  std::vector<float> values(jacobian.values.size()), residual_values(residual.size());
+  auto download = [stream](auto &host, const auto &device) {
+    THROW_ON_CUDA_ERROR(cudaMemcpyAsync(host.data(), device.data(), host.size() * sizeof(host[0]),
+                                      cudaMemcpyDeviceToHost, stream));
+  };
+  download(row_offsets, jacobian.row_offsets);
+  download(columns, jacobian.col_ids);
+  download(values, jacobian.values);
+  download(hessian_rows, hessian.row_offsets);
+  download(hessian_columns, hessian.col_ids);
+  download(residual_values, residual);
+  THROW_ON_CUDA_ERROR(cudaStreamSynchronize(stream));
